# Copy to .env and adjust. NEVER commit .env (NFR-4.7).

# ---------------------------------------------------------------- app
ENV=dev
DEBUG=true
API_PREFIX=/api/v1

# ---------------------------------------------------------------- database
DATABASE_URL=postgresql+psycopg://smartkisan:smartkisan@localhost:5432/smartkisan

# ---------------------------------------------------------------- redis
# Optional in dev — the app falls back to an in-memory cache if unreachable.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- auth
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be >= 32 bytes. The app refuses to start in production otherwise.
JWT_SECRET=dev-only-insecure-secret-change-in-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300

# ---------------------------------------------------------------- external data (all free)
# Register at https://data.gov.in to generate your own key.
# The public demo key works but caps responses at 10 records per call.
DATAGOVIN_API_KEY=

# Open-Meteo and Nominatim need no key.
# Nominatim's usage policy requires a real contact address in the User-Agent.
NOMINATIM_USER_AGENT=SmartKisan/0.1 (agri advisory; your-email@example.com)

# ---------------------------------------------------------------- cors
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
